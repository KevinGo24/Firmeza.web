@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmeza</title>
    <link rel="stylesheet" href="~/dist/main.css" />
</head>
<body>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-slate-800 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        <!-- Logo -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 mb-4 shadow-lg">
                <i class="bi bi-bank2 text-3xl text-cyan-300"></i>
            </div>
            <h1 class="text-white font-bold text-2xl tracking-tight">Firmeza</h1>
            <p class="text-blue-200 text-sm mt-1">Ingresa a tu cuenta para continuar</p>
        </div>

        <!-- Tarjeta de login -->
        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl shadow-xl p-8">

            <form method="post" class="space-y-5">

                <div>
                    <label for="email" class="block text-sm font-medium text-blue-100 mb-1">Correo electrónico</label>
                    <div class="relative">
                        <i class="bi bi-envelope absolute left-3 top-1/2 -translate-y-1/2 text-blue-300"></i>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="tucorreo@firmeza.com"
                            class="w-full pl-10 pr-3 py-2.5 bg-white/10 border border-white/20 rounded-lg text-sm text-white placeholder-blue-300/60 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400"
                        />
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label for="password" class="block text-sm font-medium text-blue-100">Contraseña</label>
                        <a href="#" class="text-xs text-cyan-300 hover:text-cyan-200 transition">¿Olvidaste tu contraseña?</a>
                    </div>
                    <div class="relative">
                        <i class="bi bi-lock absolute left-3 top-1/2 -translate-y-1/2 text-blue-300"></i>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="••••••••"
                            class="w-full pl-10 pr-3 py-2.5 bg-white/10 border border-white/20 rounded-lg text-sm text-white placeholder-blue-300/60 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400"
                        />
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <input type="checkbox" id="remember" name="remember" class="w-4 h-4 rounded border-white/20 bg-white/10 text-cyan-500 focus:ring-cyan-400" />
                    <label for="remember" class="text-sm text-blue-200">Mantener sesión iniciada</label>
                </div>

                <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-semibold text-sm py-2.5 rounded-lg transition">
                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                </button>

            </form>

            <div class="mt-6 pt-6 border-t border-white/10 text-center">
                <p class="text-blue-200 text-sm">
                    ¿No tienes cuenta?
                    <a href="#" class="text-cyan-300 hover:text-cyan-200 font-medium transition">Regístrate aquí</a>
                </p>
            </div>

        </div>

        <!-- Pie de confianza -->
        <div class="flex items-center justify-center gap-2 text-blue-300 text-sm mt-6">
            <i class="bi bi-shield-lock-fill"></i>
            <span>Conexión cifrada y protegida</span>
        </div>

    </div>
</div>

</body>
</html>