@model Firmeza.AppWeb.Models.Department
@{
    ViewData["Title"] = "Editar Departamento";
}

<div class="py-8 max-w-2xl mx-auto">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900">Editar Departamento</h1>
        <p class="text-slate-500">Actualiza la información del departamento</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

        <form asp-controller="Department" asp-action="Update" asp-route-id="@Model.Id" method="post" class="space-y-5">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

            <div>
                <label asp-for="Code" class="block text-sm font-medium text-slate-700 mb-1">Código</label>
                <input asp-for="Code" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                <span asp-validation-for="Code" class="text-red-600 text-xs"></span>
            </div>

            <div>
                <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
                <input asp-for="Name" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                <span asp-validation-for="Name" class="text-red-600 text-xs"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-sm font-medium text-slate-700 mb-1">Descripción</label>
                <textarea asp-for="Description" rows="3" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                <span asp-validation-for="Description" class="text-red-600 text-xs"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Location" class="block text-sm font-medium text-slate-700 mb-1">Ubicación</label>
                    <input asp-for="Location" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="Location" class="text-red-600 text-xs"></span>
                </div>

                <div>
                    <label asp-for="Budget" class="block text-sm font-medium text-slate-700 mb-1">Presupuesto</label>
                    <input asp-for="Budget" type="number" step="0.01" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="Budget" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Phone" class="block text-sm font-medium text-slate-700 mb-1">Teléfono</label>
                    <input asp-for="Phone" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="Phone" class="text-red-600 text-xs"></span>
                </div>

                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-1">Correo</label>
                    <input asp-for="Email" type="email" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                <label asp-for="IsActive" class="text-sm text-slate-700">Departamento activo</label>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="submit" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
                    <i class="bi bi-check-lg"></i> Guardar cambios
                </button>
                <a asp-controller="Department" asp-action="Index" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-4 py-2 rounded-lg transition">
                    <i class="bi bi-x-lg"></i> Cancelar
                </a>
            </div>

        </form>
    </div>
</div>