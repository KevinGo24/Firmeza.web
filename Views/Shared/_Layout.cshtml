<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Firmeza</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/dist/main.css" />
</head>
<body class="bg-slate-50" data-success-message="@TempData["Success"]">
<header>
    <nav class="bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-16">

            <a class="flex items-center gap-2 text-slate-900 font-bold text-lg" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bank2 text-blue-600 text-xl"></i>
                <span>Firmeza</span>
            </a>

            <!-- Menú desktop -->
            <div class="hidden sm:flex items-center gap-6">
                <ul class="flex items-center gap-6">
                    <li>
                        <a class="flex items-center gap-1 text-slate-700 hover:text-blue-600 transition" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>
                    <li>
                        <a class="flex items-center gap-1 text-slate-700 hover:text-blue-600 transition" asp-area="" asp-controller="" asp-action="">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li>
                        <a class="flex items-center gap-1 text-slate-700 hover:text-blue-600 transition" asp-area="" asp-controller="Department" asp-action="Index">
                            <i class="bi bi-building"></i> Departamentos
                        </a>
                    </li>
                    <li>
                        <a class="flex items-center gap-1 text-slate-700 hover:text-blue-600 transition" asp-area="" asp-controller="" asp-action="">
                            <i class="bi bi-people"></i> Clientes
                        </a>
                    </li>
                    <li>
                        <a class="flex items-center gap-1 text-slate-700 hover:text-blue-600 transition" asp-area="" asp-controller="Home" asp-action="Privacy">
                            <i class="bi bi-shield-check"></i> Privacy
                        </a>
                    </li>
                </ul>

                <a class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition"
                   asp-area="" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                </a>
            </div>

            <!-- Botón hamburguesa (solo móvil) -->
            <button id="navToggle" type="button" class="sm:hidden text-slate-700" aria-label="Toggle navigation">
                <i class="bi bi-list text-2xl"></i>
            </button>
        </div>

        <!-- Menú móvil (oculto por defecto) -->
        <ul id="navMenu" class="hidden sm:hidden flex-col gap-3 px-4 pb-4">
            <li>
                <a class="flex items-center gap-1 text-slate-700 hover:text-blue-600 transition" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Home
                </a>
            </li>
            <li>
                <a class="flex items-center gap-1 text-slate-700 hover:text-blue-600 transition" asp-area="" asp-controller="Home" asp-action="Privacy">
                    <i class="bi bi-shield-check"></i> Privacy
                </a>
            </li>
            <li>
                <a class="flex items-center gap-1 text-blue-600 font-medium hover:text-blue-700 transition"
                   asp-area="" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                </a>
            </li>
        </ul>
    </nav>
</header>

<div class="max-w-6xl mx-auto px-4">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-t border-slate-200 text-slate-500 text-sm mt-8">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center gap-1">
        <i class="bi bi-c-circle"></i> 2026 - Firmeza.AppWeb -
        <a asp-area="" asp-controller="Home" asp-action="Privacy" class="flex items-center gap-1 hover:text-blue-600">
            <i class="bi bi-shield-lock"></i> Privacy
        </a>
    </div>
</footer>

<script>
    document.getElementById('navToggle').addEventListener('click', function () {
        document.getElementById('navMenu').classList.toggle('hidden');
    });
</script>

<script type="module" src="~/dist/main.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>+